    "jspdf": "4.2.1",
    "maplibre-contour": "0.1.1",
    "maplibre-gl": "6.18.0",
    "pdfjs-dist": "6.3.289",
    "sql.js": "1.16.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
